<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge this block into the target application's own web.config to install the module.

  The module ships as a SINGLE assembly (System.Text.Json and its dependency chain are ILRepacked
  into Portmirror.IisModule.dll and internalized), so no runtime/assemblyBinding redirects are
  needed — drop Portmirror.IisModule.dll next to the app's bin and register it below.

  Fault injection also needs the app not to replace an injected error body with its own error page;
  the module sets Response.TrySkipIisCustomErrors, so no config change is required for that either.
-->
<configuration>
  <system.webServer>
    <modules>
      <add name="Portmirror" type="Portmirror.IisModule.PortmirrorHttpModule, Portmirror.IisModule" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
